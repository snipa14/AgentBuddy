COMPOSE_PROJECT_NAME=foundry

# Set by scripts/start.sh depending on whether --local-llm was passed;
# copy this file to .env only if you want to override the default manually.
OLLAMA_ENABLED=false

# Absolute host path of this repo's projects/ directory. Required by the
# Executor to bind-mount project directories into workspace containers
# correctly -- see services/executor/SECURITY.md ("The Docker-outside-of-
# Docker (DooD) detail"). Example: /home/mate/foundry/projects
PROJECTS_HOST_PATH=
