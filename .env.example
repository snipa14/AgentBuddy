COMPOSE_PROJECT_NAME=foundry

# Informational only -- OLLAMA_ENABLED is NOT read from .env. It's hardcoded
# "false" in docker-compose.yml and overridden to "true" by
# docker-compose.local-llm.yml, selected by whether `./scripts/start.sh` was
# run with --local-llm (see scripts/start.sh's compose_files logic). Setting
# OLLAMA_ENABLED here has no effect.
OLLAMA_ENABLED=false

# Absolute host path of this repo's projects/ directory. Required by the
# Executor to bind-mount project directories into workspace containers
# correctly -- see services/executor/SECURITY.md ("The Docker-outside-of-
# Docker (DooD) detail"). Example: /home/mate/foundry/projects
PROJECTS_HOST_PATH=
