#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
    cat <<'EOF'
Usage: foundry <command> [args]

Commands:
  up            Start the Foundry stack (accepts --local-llm)
  down          Stop the Foundry stack
  status        Show status of Foundry services
  new-project   Register a new project (greenfield or brownfield)
  logs          Tail logs from Foundry services (accepts service names)

  -h, --help    Show this help message
EOF
}

command="${1:-}"

case "$command" in
    up)
        shift
        exec "$ROOT_DIR/scripts/start.sh" "$@"
        ;;
    down)
        exec "$ROOT_DIR/scripts/stop.sh"
        ;;
    status)
        exec docker compose -f "$ROOT_DIR/docker-compose.yml" ps
        ;;
    logs)
        shift
        exec docker compose -f "$ROOT_DIR/docker-compose.yml" logs -f "$@"
        ;;
    new-project)
        shift
        exec docker compose -f "$ROOT_DIR/docker-compose.yml" exec orchestrator \
            python3 -m services.orchestrator.registry.cli "$@"
        ;;
    -h|--help|"")
        usage
        ;;
    *)
        echo "foundry: unknown command '$command'" >&2
        usage >&2
        exit 1
        ;;
esac
